# Nothing here is needed to run the app locally: RUN-LOCAL-TEST.bat starts the API with a test database and no login.
#
# VITE_SUPABASE_URL / VITE_SUPABASE_ANON_KEY: login (Supabase Auth). Set as GitHub variables by START-HERE.bat and
# baked into the production build by the pipeline. Leave them unset locally: no login, the local API answers as Admin.
# VITE_SUPABASE_URL="https://<project-ref>.supabase.co"
# VITE_SUPABASE_ANON_KEY="<anon or publishable key>"
#
# BACKEND_URL: where `npm run dev` forwards /api/v1 (default http://localhost:8787, the local API Worker).
# BACKEND_URL="http://localhost:8787"
