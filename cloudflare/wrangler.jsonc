// SM HBD CRM on Cloudflare (Workers FREE plan): ONE Worker is the whole app.
//   - /api/*   the backend (TypeScript in src/), talking to Supabase Postgres
//   - the rest the React build (../dist) as static assets
// Deployed ONLY by the pipeline (.github/workflows/ship.yml, step 5) together with the frontend.
// Workers Builds must stay disconnected - a second deployer would race the pipeline.
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "sm-hbd-crm",
  "main": "src/index.ts",
  "compatibility_date": "2026-09-01",
  // postgres.js talks to Supabase over TCP (cloudflare:sockets) and needs the Node.js compatibility layer.
  "compatibility_flags": ["nodejs_compat"],
  "observability": { "enabled": true },

  "assets": {
    "directory": "../dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"]
  },

  // Settings (not secret). The pipeline adds BUILD_SHA and SUPABASE_URL with --var.
  "vars": {},
  // Supabase Postgres through Hyperdrive. The pipeline (scripts/hyperdrive.mjs) creates / updates the Hyperdrive
  // config "sm-hbd-crm-db" from the GitHub secret SUPABASE_DB_URL and deploys with its real id; the id below is only
  // a stand-in for local runs, which use CLOUDFLARE_HYPERDRIVE_LOCAL_CONNECTION_STRING_HYPERDRIVE instead.
  "hyperdrive": [{ "binding": "HYPERDRIVE", "id": "00000000000000000000000000000000" }]
  // Secret (never in git): optional SUPABASE_SERVICE_ROLE_KEY (Staff mapping > Create login), uploaded by the
  // pipeline with wrangler deploy --secrets-file.
}
